{
  "name": "troba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && pnpm --filter @troba/web dev",
    "build": "pnpm --filter @troba/web build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @troba/web exec next typegen && tsc -b",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test -c apps/web/playwright.config.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "pnpm --filter @troba/db generate",
    "db:migrate": "node --env-file-if-exists=.env.example --env-file-if-exists=.env packages/db/src/migrate-cli.ts",
    "admin:create": "node apps/web/src/build-cli.ts apps/web/.cli && node --env-file-if-exists=.env.example --env-file-if-exists=.env apps/web/.cli/scripts/create-admin.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
