# Local development defaults. Copy to .env to override; .env is gitignored.
# Outside production, missing variables fall back to these values.

# Postgres container (compose.yaml)
POSTGRES_USER=troba
POSTGRES_PASSWORD=troba
POSTGRES_DB=troba
POSTGRES_PORT=55432

# App connection string; must match the container settings above.
DATABASE_URL=postgres://troba:troba@localhost:55432/troba

# Reported by /api/health. Set to the git sha when the image is built.
GIT_SHA=dev
