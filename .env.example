# Local development defaults. Copy to .env to override; .env is gitignored.
# Outside production, missing variables fall back to these values.

# Postgres container (compose.yaml)
POSTGRES_USER=troba
POSTGRES_PASSWORD=troba
POSTGRES_DB=troba
POSTGRES_PORT=55432

# App connection string; must match the container settings above.
DATABASE_URL=postgres://troba:troba@localhost:55432/troba

# Reported by /api/health. Set to the git sha when the image is built.
GIT_SHA=dev

# Better Auth. The secret signs session cookies; this one is for local development only.
# In production set a real one: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-secret-not-for-production-use-0000
# The public origin of the app. Local dev and the e2e server override it with their own.
BETTER_AUTH_URL=http://localhost:3000

# Users' files (receipts), one folder per user. The Docker image sets its own.
UPLOADS_DIR=uploads
