{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    // scripts/ runs on Node directly, which needs the .ts extension in its relative imports.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "scripts"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/db" }]
}
