{
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "agent-skills@addy-agent-skills": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-status.mjs\"",
            "timeout": 30,
            "statusMessage": "Reading workflow status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the review gate"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking worktree and commit rules"
          }
        ]
      }
    ]
  }
}
